{
  "name": "c-agent",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript 实现的编码代理：外层/内层双循环、统一大模型接口、可插拔工具",
  "type": "module",
  "main": "desktop/main/entry.mjs",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx tests/run.ts",
    "typecheck:desktop": "tsc -p desktop/tsconfig.main.json --noEmit && tsc -p desktop/tsconfig.renderer.json --noEmit",
    "desktop:build:main": "tsc -p desktop/tsconfig.main.json && npm run desktop:main:write-cjs-pkg && node scripts/desktop-connector-dist.cjs",
    "desktop:build:renderer": "vite build --config desktop/vite.config.ts",
    "desktop:build": "npm run desktop:build:main && npm run desktop:build:renderer",
    "desktop:dev": "npm run desktop:ensure-mic-plist && npm run desktop:build:main && concurrently -k -n vite,electron \"vite --config desktop/vite.config.ts\" \"wait-on http-get://127.0.0.1:5173 && electron .\"",
    "desktop:dev:safe": "env -u CODEBUDDY_BROKERED_FS_HOOK_ENABLED -u CODEBUDDY_SAFE_DELETE_SANDBOX -u CODEBUDDY_SANDBOX_BROKER_IPC_ADDRESS -u CODEBUDDY_SANDBOX_BROKER_SESSION_ID -u CODEBUDDY_SANDBOX_HOST_FILE_OPERATION_COMMAND -u ELECTRON_RUN_AS_NODE -u WORKBUDDY_NODE_ENV -u NODE_OPTIONS npm run desktop:dev",
    "desktop:main:write-cjs-pkg": "node -e \"require('fs').writeFileSync('desktop/main/dist/package.json', JSON.stringify({type: 'commonjs'}, null, 2) + '\\n')\"",
    "desktop:ensure-mic-plist": "node scripts/ensure-mic-plist.cjs",
    "bot:weixin": "tsx src/bot/weixin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-memory": "^2026.8.31",
    "@modelcontextprotocol/server-sequential-thinking": "^2026.8.31",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@types/ws": "^8.18.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "postcss": "^8.4.49",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "wait-on": "^8.0.0"
  }
}
